# Data files
*.xlsx
*.xls
*.csv
*.pdf
*.doc
*.docx
*.pkl
*.parquet

# Ignore data content but keep directory structure
data/raw/*
data/output/*
data/processed/*
!data/raw/.gitkeep
!data/output/.gitkeep
!data/processed/.gitkeep

# Specific JSON files to ignore
*.json
!**/example*.json
!**/template*.json
!desktop/package.json
!desktop/package-lock.json
!data/knowledge_base/structured/*.json
!data/knowledge_base/structured/*.parquet
!data/evaluation/full_pipeline_heldout_v1.json
!data/evaluation/full_pipeline_heldout_v1.manifest.json
# Keep knowledge_base key subdirectories tracked
!data/knowledge_base/template_spec/*.xlsx
# Keep example files for user guide
!data/examples/*.xlsx

# Environment and config
.env
.cursorrules

# Logs
*.log
.run/

# Test fixtures (auto-generated)
tests/fixtures/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo

# Type / lint / test caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
report*.xml
.tox/
.cache/
*.egg-info/

# Virtual envs
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# Local scratch / experiments
my_test/

# Archive folders
**/archive/

# Virtual environment
venv/

# Temporary docs
docs/
!docs/
docs/*
!docs/adr/
docs/adr/*
!docs/adr/*.md

CLAUDE.md
!/CLAUDE.md

# audit logs
data/audit_logs/

# Desktop packaging build output
node_modules/
desktop/node_modules/
desktop/dist/
/build/
/dist/

.DS_Store
